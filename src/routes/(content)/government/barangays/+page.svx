<script>
	import { barangays } from "$lib/data/government.data";
	import Source from "$lib/components/macro/source.svelte";
	import ContactAction from "$lib/components/macro/contact-action.svelte";
	import { splitPhoneNumbers } from "$lib/utils/contact";
	import Phone from "@lucide/svelte/icons/phone";
	import User from "@lucide/svelte/icons/user";
</script>

# {title}

{barangays.description}

<ul class="barangays">
	{#each barangays.data as barangay (barangay.name)}
		<li>
			<h2>{barangay.name}</h2>
			<p><User /> {barangay.captain}</p>
			<p class="contact"><Phone /> <ContactAction phone={splitPhoneNumbers(barangay.phoneNumber)[0]} phoneType="mobile" /></p>
		</li>
	{/each}
</ul>

<Source source={barangays.source} />

