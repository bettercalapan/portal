---
layout: content
title: Statistics
---

<script lang="ts">
	import Source from "$lib/components/macro/source.svelte";
	import {
		cityIncomeSource,
		cityIncomeStatistics,
		competitivenessSource,
		generalStatistics,
		populationSource
	} from "$lib/data/statistics.data";
	import { createChartLoadQueue } from "./chart-load-queue";
	import DeferredChart from "./deferred-chart.svelte";

	const loadPopulationGrowthChart = () => import("./population-growth-chart.svelte");
	const loadPopulationDistributionChart = () => import("./population-distribution-chart.svelte");
	const loadCompetitivenessChart = () => import("./competitiveness-chart.svelte");
	const chartLoadQueue = createChartLoadQueue();
	const formatHeadlineStatistic = (
		value: string | number,
		format: (typeof generalStatistics | typeof cityIncomeStatistics)[number]["format"]
	) => {
		switch (format) {
			case "number":
				return Number(value).toLocaleString("en-US");
			case "decimal":
				return Number(value).toFixed(2);
			case "currency-billions":
				return `₱${(Number(value) / 1_000_000_000).toFixed(2)}B`;
			case "percent":
				return `${Number(value).toFixed(1)}%`;
			default:
				return value;
		}
	};
</script>

# {title}

Data and statistics about Calapan City.

<div class="primary-wrapper">
	<div class="section general">
		<h2>General</h2>
		<div class="content">
			{#each generalStatistics as statistic (statistic.label)}
				<div>
					<p class="count">{formatHeadlineStatistic(statistic.value, statistic.format)}</p>
					<p class="label">{statistic.label}</p>
				</div>
			{/each}
		</div>
		<Source source={populationSource} />
	</div>
	<div class="section city-income">
		<h2>City Income</h2>
		<div class="content">
			{#each cityIncomeStatistics as statistic (statistic.label)}
				<div>
					<p class="count">{formatHeadlineStatistic(statistic.value, statistic.format)}</p>
					<p class="label">{statistic.label}</p>
				</div>
			{/each}
		</div>
		<Source source={cityIncomeSource} />
	</div>
	<div class="section growth">
		<h2>Growth</h2>
		<DeferredChart
			load={loadPopulationGrowthChart}
			queue={chartLoadQueue}
			mobileHeight={368}
			label="Loading population growth chart"
		/>
		<Source source={populationSource} />
	</div>
	<div class="section distribution">
		<h2>Distribution</h2>
		<DeferredChart
			load={loadPopulationDistributionChart}
			queue={chartLoadQueue}
			mobileHeight={408}
			label="Loading population distribution chart"
		/>
		<Source source={populationSource} />
	</div>
	<div class="section competitiveness">
		<h2>Competitiveness</h2>
		<DeferredChart
			load={loadCompetitivenessChart}
			queue={chartLoadQueue}
			mobileHeight={470}
			desktopHeight={494}
			label="Loading competitiveness chart"
		/>
		<Source source={competitivenessSource} />
	</div>
</div>

<style>
	.primary-wrapper {
		margin-top: 2rem;
		margin-bottom: 1rem;
		display: flex;
		flex-direction: column;
		gap: 2rem;

		.section {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;

			h2 {
				margin: 0;
			}

			.content {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
				gap: 1rem;

				> div {
					background-color: var(--neutral-light);
					padding: 1.5rem;
					border-radius: 2rem;

					p {
						margin: 0;
					}

					.count {
						font-size: 2rem;
						font-weight: 600;
					}
				}
			}
		}
	}

	@media (min-width: 900px) {
		h2 {
			font-size: 2rem;
		}
	}
</style>
