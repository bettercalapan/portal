{
	"name": "bettercalapan",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"verify": "pnpm gen && pnpm lint && pnpm check && pnpm test && pnpm test:routes && pnpm benchmark && pnpm pa11y && pnpm lychee && pnpm preview",
		"deploy": "wrangler deploy",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"gen": "wrangler types",
		"benchmark": "node scripts/benchmark.mjs ci",
		"benchmark:mobile": "node scripts/benchmark.mjs mobile",
		"benchmark:desktop": "node scripts/benchmark.mjs desktop",
		"benchmark:ci": "node scripts/benchmark.mjs ci",
		"pa11y": "node scripts/pa11y.mjs all",
		"pa11y:mobile": "node scripts/pa11y.mjs mobile",
		"pa11y:desktop": "node scripts/pa11y.mjs desktop",
		"pa11y:ci": "node scripts/pa11y.mjs ci",
		"lychee": "node scripts/lychee.mjs",
		"lychee:ci": "node scripts/lychee.mjs ci",
		"test:routes": "node scripts/route-smoke.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/d3-shape": "^3.1.8",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mdsvex": "^0.12.8",
		"pa11y-ci": "^4.1.1",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"rehype-slug": "^6.0.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"unlighthouse": "^0.18.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.28.0",
		"bits-ui": "^2.18.1",
		"d3-shape": "^3.2.0",
		"fuse.js": "^7.5.0",
		"layerchart": "^2.0.4"
	}
}
